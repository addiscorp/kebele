{
  "name": "kebele",
  "version": "0.10.0",
  "description": "Run and manage Docker container stacks over the Docker socket. Agent-first CLI and library.",
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "kebele": "src/kebele.ts"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "start": "bun src/kebele.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/addiscorp/kebele.git"
  },
  "homepage": "https://github.com/addiscorp/kebele",
  "author": "Sami Fouad",
  "license": "Apache-2.0",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "docker",
    "containers",
    "stacks",
    "cli",
    "agents"
  ]
}
